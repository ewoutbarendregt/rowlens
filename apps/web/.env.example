# Local development: copy to apps/web/.env (git-ignored). Matches infra/compose/docker-compose.dev.yml.
#   docker compose -f infra/compose/docker-compose.dev.yml up -d && pnpm db:migrate
DATABASE_URL=postgres://rowlens_app:rowlens_app_dev_only@127.0.0.1:5433/rowlens
DATABASE_OWNER_URL=postgres://rowlens_owner:rowlens_dev_only@127.0.0.1:5433/rowlens
ROWLENS_APP_DB_PASSWORD=rowlens_app_dev_only
# The Vite dev server (:5173) proxies to :3000; state-changing requests must come from this origin.
PUBLIC_ORIGIN=http://localhost:5173
# Pilot access code (#84) for local use: `pnpm --filter @rowlens/web pilot:code` prints a code and
# its hash; put the hash here. SESSION_SECRET: `openssl rand -hex 32`.
# PILOT_ACCESS_CODE_HASH=
# SESSION_SECRET=
