# Local development: `cp apps/web/.env.example apps/web/.env` (git-ignored), then see CLAUDE.md:
#   pnpm dev:up   # Postgres + worker in Docker, migrations
#   pnpm dev      # web app with hot reload → http://localhost:5174/projects/rowlens/
# Ports avoid other local projects (Postgres 5434, API 3100, app 5174).
PORT=3100
API_PORT=3100
DEV_PORT=5174
PUBLIC_ORIGIN=http://localhost:5174
DATABASE_URL=postgres://rowlens_app:rowlens_app_dev_only@127.0.0.1:5434/rowlens
DATABASE_OWNER_URL=postgres://rowlens_owner:rowlens_dev_only@127.0.0.1:5434/rowlens
ROWLENS_APP_DB_PASSWORD=rowlens_app_dev_only
# Video bytes, shared with the worker container (git-ignored).
MEDIA_DIR=.media
# One-club email authentication (#28–#30). In development the six-digit code is logged by the API;
# production additionally requires SMTP_HOST, SMTP_USER and SMTP_PASSWORD.
AUTH_ALLOWED_EMAILS=rowlens@localhost.test
OTP_PEPPER=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=
# MAIL_FROM=RowLens <rowlens@trustable.nl>

# Always admin (#42); admins admit everyone else in the app (Admin → Access).
# AUTH_ADMIN_EMAILS=you@example.com
