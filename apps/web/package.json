{
  "name": "@rowlens/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client && tsc -p e2e",
    "test": "vitest run",
    "dev:server": "node --watch --experimental-strip-types src/server/main.ts",
    "dev:client": "vite",
    "e2e": "playwright test",
    "e2e:edge": "E2E_EDGE_URL=http://localhost:${EDGE_PORT:-8080} playwright test --project desktop-chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  }
}
