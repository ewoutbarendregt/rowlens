{
  "name": "rowlens",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "RowLens — video review and traceable technique analysis for rowing clubs",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "edge:up": "docker compose -f infra/compose/docker-compose.edge.yml up -d --build --wait",
    "edge:down": "docker compose -f infra/compose/docker-compose.edge.yml down",
    "e2e:edge": "pnpm --filter @rowlens/web e2e:edge",
    "demo:media": "bash scripts/demo-media/generate.sh",
    "db:migrate": "pnpm --filter @rowlens/web db:migrate",
    "dev:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d --build --wait db && pnpm db:migrate && docker compose -f infra/compose/docker-compose.dev.yml up -d --build worker",
    "dev": "pnpm --filter @rowlens/web run \"/^dev:(server|client)$/\"",
    "dev:down": "docker compose -f infra/compose/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
