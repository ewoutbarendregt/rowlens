{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/HANDOFF.md", "PLAN.md"],
  "permission": {
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git push *": "allow",
      "git push * main": "deny",
      "git push * main *": "deny",
      "git push * *:main": "deny",
      "git push * HEAD:main*": "deny",
      "git push *--force*": "deny",
      "git push * -f*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "ask",
      "gh pr merge *": "ask",
      "gh workflow run *": "ask",
      "gh release *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "rm -rf *": "ask",
      "docker system prune*": "deny",
      "docker volume rm *": "ask",
      "docker volume prune*": "deny",
      "docker compose * down -v*": "ask",
      "pnpm dev:down -v*": "ask"
    }
  }
}
